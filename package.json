{
  "name": "aisrestroos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/desktop"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "build:frontend": "npm --prefix apps/frontend run build",
    "test:frontend": "npm --prefix apps/frontend run test",
    "test:backend": "python -m pytest apps/backend/tests -v",
    "test": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:rebuild": "docker compose up --build --force-recreate"
  }
}
