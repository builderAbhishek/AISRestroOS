# AISRestroOS Environment Configuration

# Environment mode: development | staging | production
ENVIRONMENT=development

# Database configuration (SQLite local database)
# In Docker, database is mounted at /app/data/aisrestroos.db
DATABASE_URL=sqlite:////app/data/aisrestroos.db
# When running backend natively on host Windows machine:
LOCAL_DATABASE_URL=sqlite:///./data/db/aisrestroos.db

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Frontend API URL (accessible by browser)
VITE_API_URL=http://localhost:8000

# SQLite settings
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_WAL_MODE=true

# Logging
LOG_LEVEL=INFO

# App identity
APP_NAME=AISRestroOS
APP_VERSION=1.0.0
